{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusworld.local/contracts/ontology-contract-v1.json",
  "$defs": {
    "EntityType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "domain", "displayName", "description", "requiredAttributes", "aggregateOnly"],
      "properties": {
        "code": { "type": "string" },
        "domain": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "requiredAttributes": { "type": "array", "items": { "type": "string" } },
        "aggregateOnly": { "type": "boolean" }
      }
    },
    "RelationshipType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "sourceType", "targetType", "description", "temporal"],
      "properties": {
        "code": { "type": "string" },
        "sourceType": { "type": "string" },
        "targetType": { "type": "string" },
        "description": { "type": "string" },
        "temporal": { "type": "boolean" }
      }
    },
    "PropertyDataType": {
      "enum": ["STRING", "INTEGER", "NUMBER", "BOOLEAN", "DATE", "DATE_TIME", "UUID", "URI", "OBJECT", "ARRAY"]
    },
    "PropertyType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityType", "code", "displayName", "description", "dataType", "required", "unit", "classification"],
      "properties": {
        "entityType": { "type": "string" },
        "code": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "dataType": { "$ref": "#/$defs/PropertyDataType" },
        "required": { "type": "boolean" },
        "unit": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] }
      }
    },
    "ActionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "actorType", "targetType", "description", "parametersSchema"],
      "properties": {
        "code": { "type": "string" },
        "actorType": { "type": "string" },
        "targetType": { "type": "string" },
        "description": { "type": "string" },
        "parametersSchema": { "type": "object" }
      }
    },
    "ValidateAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionCode", "actorType", "targetType", "parameters"],
      "properties": {
        "actionCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "actorType": { "type": "string", "minLength": 1, "maxLength": 48 },
        "targetType": { "type": "string", "minLength": 1, "maxLength": 48 },
        "parameters": { "type": "object" }
      }
    },
    "ActionValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "actionCode", "actorType", "targetType", "valid", "errors"],
      "properties": {
        "contractVersion": { "const": "v1" },
        "actionCode": { "type": "string" },
        "actorType": { "type": "string" },
        "targetType": { "type": "string" },
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "CreateGraphEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityType", "naturalKey", "displayName"],
      "properties": {
        "entityType": { "type": "string", "minLength": 1, "maxLength": 48 },
        "naturalKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "attributes": { "type": "object" },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "GraphEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "id", "worldVersionId", "entityType", "naturalKey", "displayName", "attributes", "validFrom", "validTo", "createdBy", "createdAt"],
      "properties": {
        "contractVersion": { "const": "v1" },
        "id": { "type": "string", "format": "uuid" },
        "worldVersionId": { "type": "string", "format": "uuid" },
        "entityType": { "type": "string" },
        "naturalKey": { "type": "string" },
        "displayName": { "type": "string" },
        "attributes": { "type": "object" },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" },
        "createdBy": { "type": "string", "format": "uuid" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CreateGraphRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationshipType", "sourceEntityId", "targetEntityId"],
      "properties": {
        "relationshipType": { "type": "string", "minLength": 1, "maxLength": 48 },
        "sourceEntityId": { "type": "string", "format": "uuid" },
        "targetEntityId": { "type": "string", "format": "uuid" },
        "attributes": { "type": "object" },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "GraphRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "id", "worldVersionId", "relationshipType", "sourceEntityId", "sourceEntityType", "targetEntityId", "targetEntityType", "attributes", "validFrom", "validTo", "createdBy", "createdAt"],
      "properties": {
        "contractVersion": { "const": "v1" },
        "id": { "type": "string", "format": "uuid" },
        "worldVersionId": { "type": "string", "format": "uuid" },
        "relationshipType": { "type": "string" },
        "sourceEntityId": { "type": "string", "format": "uuid" },
        "sourceEntityType": { "type": "string" },
        "targetEntityId": { "type": "string", "format": "uuid" },
        "targetEntityType": { "type": "string" },
        "attributes": { "type": "object" },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" },
        "createdBy": { "type": "string", "format": "uuid" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ResolutionIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "value"],
      "properties": {
        "scheme": { "type": "string", "minLength": 2, "maxLength": 48 },
        "value": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "ResolveGraphEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityType", "naturalKey", "displayName"],
      "properties": {
        "entityType": { "type": "string", "minLength": 1, "maxLength": 48 },
        "naturalKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "attributes": { "type": "object" },
        "identifiers": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/ResolutionIdentifier" } },
        "sourceSystem": { "type": ["string", "null"], "maxLength": 32 },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "EntityResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "decision", "entity", "matchedSchemes"],
      "properties": {
        "contractVersion": { "const": "v1" },
        "decision": { "enum": ["CREATED", "MATCHED"] },
        "entity": { "$ref": "#/$defs/GraphEntity" },
        "matchedSchemes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "GraphProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "projectionId", "worldVersionId", "status", "entityCount", "relationshipCount", "startedAt", "completedAt", "error"],
      "properties": {
        "contractVersion": { "const": "v1" },
        "projectionId": { "type": "string", "format": "uuid" },
        "worldVersionId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["RUNNING", "SUCCEEDED", "FAILED"] },
        "entityCount": { "type": "integer", "minimum": 0 },
        "relationshipCount": { "type": "integer", "minimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "error": { "type": ["string", "null"] }
      }
    },
    "ProjectedNode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entityType", "naturalKey", "displayName", "attributes"],
      "properties": {
        "id": { "type": "string", "format": "uuid" }, "entityType": { "type": "string" },
        "naturalKey": { "type": "string" }, "displayName": { "type": "string" }, "attributes": { "type": "object" }
      }
    },
    "ProjectedRelationship": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "relationshipType", "sourceEntityId", "targetEntityId", "attributes"],
      "properties": {
        "id": { "type": "string", "format": "uuid" }, "relationshipType": { "type": "string" },
        "sourceEntityId": { "type": "string", "format": "uuid" },
        "targetEntityId": { "type": "string", "format": "uuid" }, "attributes": { "type": "object" }
      }
    },
    "GraphPaths": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "worldVersionId", "rootEntityId", "maxDepth", "paths"],
      "properties": {
        "contractVersion": { "const": "v1" }, "worldVersionId": { "type": "string", "format": "uuid" },
        "rootEntityId": { "type": "string", "format": "uuid" }, "maxDepth": { "type": "integer", "minimum": 1, "maximum": 3 },
        "paths": { "type": "array", "items": { "type": "object", "additionalProperties": false,
          "required": ["nodes", "relationships"], "properties": {
            "nodes": { "type": "array", "items": { "$ref": "#/$defs/ProjectedNode" } },
            "relationships": { "type": "array", "items": { "$ref": "#/$defs/ProjectedRelationship" } }
          } }
        }
      }
    },
    "GraphNodeMatches": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "worldVersionId", "query", "matches"],
      "properties": {
        "contractVersion": { "const": "v1" },
        "worldVersionId": { "type": "string", "format": "uuid" },
        "query": { "type": "string" },
        "matches": { "type": "array", "items": { "$ref": "#/$defs/ProjectedNode" } }
      }
    },
    "Ontology": {
      "type": "object",
      "required": ["contractVersion", "ontologyVersion", "entityTypes", "propertyTypes", "relationshipTypes", "actionTypes"],
      "properties": {
        "contractVersion": { "const": "v1" },
        "ontologyVersion": { "const": "economic-civilization-v1" },
        "entityTypes": { "type": "array", "items": { "$ref": "#/$defs/EntityType" } },
        "propertyTypes": { "type": "array", "items": { "$ref": "#/$defs/PropertyType" } },
        "relationshipTypes": { "type": "array", "items": { "$ref": "#/$defs/RelationshipType" } },
        "actionTypes": { "type": "array", "items": { "$ref": "#/$defs/ActionType" } }
      }
    },
    "WorldGraph": {
      "type": "object",
      "required": ["contractVersion", "ontologyVersion", "worldVersionId", "entities", "relationships"],
      "properties": {
        "contractVersion": { "const": "v1" },
        "ontologyVersion": { "const": "economic-civilization-v1" },
        "worldVersionId": { "type": "string", "format": "uuid" },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/GraphEntity" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/GraphRelationship" } }
      }
    }
  }
}
