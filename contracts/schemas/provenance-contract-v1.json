{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusworld.local/contracts/provenance-contract-v1.json",
  "$defs": {
    "SourceType": { "enum": ["DATASET", "DOCUMENT", "WEB_PAGE", "API", "USER_INPUT"] },
    "EvidenceType": { "enum": ["FACT", "MEASUREMENT", "EXCERPT", "TABLE_CELL", "FIGURE", "DERIVATION"] },
    "AssumptionStatus": { "enum": ["DRAFT", "ACTIVE", "RETIRED"] },
    "CreateSource": {
      "type": "object",
      "required": ["sourceKey", "sourceType", "title", "retrievedAt"],
      "properties": {
        "sourceKey": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sourceType": { "$ref": "#/$defs/SourceType" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "publisher": { "type": ["string", "null"], "maxLength": 240 },
        "canonicalUri": { "type": ["string", "null"], "format": "uri" },
        "sourceVersion": { "type": ["string", "null"], "maxLength": 120 },
        "license": { "type": ["string", "null"], "maxLength": 160 },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "contentSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "metadata": { "type": "object" }
      }
    },
    "Source": {
      "allOf": [
        { "$ref": "#/$defs/CreateSource" },
        { "type": "object", "required": ["contractVersion", "id", "createdBy", "createdAt"],
          "properties": {
            "contractVersion": { "const": "v1" }, "id": { "type": "string", "format": "uuid" },
            "createdBy": { "type": "string", "format": "uuid" }, "createdAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "CreateEvidence": {
      "type": "object",
      "required": ["sourceId", "evidenceType", "claimText", "confidence"],
      "anyOf": [{ "required": ["excerpt"] }, { "required": ["measuredValue"] }],
      "properties": {
        "sourceId": { "type": "string", "format": "uuid" }, "evidenceType": { "$ref": "#/$defs/EvidenceType" },
        "claimText": { "type": "string", "minLength": 1 }, "locator": { "type": "object" },
        "excerpt": { "type": ["string", "null"], "minLength": 1 }, "measuredValue": {},
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "Evidence": {
      "allOf": [{ "$ref": "#/$defs/CreateEvidence" },
        { "type": "object", "required": ["contractVersion", "id", "createdBy", "createdAt"],
          "properties": { "contractVersion": { "const": "v1" }, "id": { "type": "string", "format": "uuid" },
            "createdBy": { "type": "string", "format": "uuid" }, "createdAt": { "type": "string", "format": "date-time" } } }]
    },
    "CreateAssumption": {
      "type": "object",
      "required": ["assumptionKey", "category", "statement", "rationale", "status", "confidence"],
      "properties": {
        "assumptionKey": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 }, "statement": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }, "assumedValue": {}, "unit": { "type": ["string", "null"], "maxLength": 80 },
        "status": { "$ref": "#/$defs/AssumptionStatus" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "validFrom": { "type": ["string", "null"], "format": "date-time" }, "validTo": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "Assumption": {
      "allOf": [{ "$ref": "#/$defs/CreateAssumption" },
        { "type": "object", "required": ["contractVersion", "id", "createdBy", "createdAt"],
          "properties": { "contractVersion": { "const": "v1" }, "id": { "type": "string", "format": "uuid" },
            "createdBy": { "type": "string", "format": "uuid" }, "createdAt": { "type": "string", "format": "date-time" } } }]
    },
    "CreateProvenanceLink": {
      "type": "object",
      "required": ["subjectType", "subjectId", "propertyPath"],
      "oneOf": [
        { "required": ["evidenceId"], "properties": { "evidenceId": { "type": "string", "format": "uuid" }, "assumptionId": { "type": "null" } } },
        { "required": ["assumptionId"], "properties": { "evidenceId": { "type": "null" }, "assumptionId": { "type": "string", "format": "uuid" } } }
      ],
      "properties": {
        "subjectType": { "type": "string", "minLength": 1, "maxLength": 80 }, "subjectId": { "type": "string", "format": "uuid" },
        "propertyPath": { "type": "string", "maxLength": 240, "pattern": "^(/([^/~]|~[01])*)*$" },
        "evidenceId": { "type": ["string", "null"], "format": "uuid" }, "assumptionId": { "type": ["string", "null"], "format": "uuid" },
        "transformation": { "type": "object" }
      }
    },
    "ProvenanceLink": {
      "allOf": [{ "$ref": "#/$defs/CreateProvenanceLink" },
        { "type": "object", "required": ["contractVersion", "id", "createdBy", "createdAt"],
          "properties": { "contractVersion": { "const": "v1" }, "id": { "type": "string", "format": "uuid" },
            "createdBy": { "type": "string", "format": "uuid" }, "createdAt": { "type": "string", "format": "date-time" } } }]
    }
  }
}
