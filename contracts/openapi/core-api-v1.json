{
  "openapi": "3.1.0",
  "info": { "title": "NEXUS WORLD Core API", "version": "1.6.0" },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 1, "maxLength": 80 },
          "password": { "type": "string", "minLength": 1, "format": "password" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractVersion",
          "accessToken",
          "tokenType",
          "expiresIn",
          "refreshToken",
          "refreshExpiresIn"
        ],
        "properties": {
          "contractVersion": { "const": "v1" },
          "accessToken": { "type": "string", "minLength": 1 },
          "tokenType": { "const": "Bearer" },
          "expiresIn": { "type": "integer", "minimum": 1 },
          "refreshToken": { "type": "string", "minLength": 1 },
          "refreshExpiresIn": { "type": "integer", "minimum": 1 }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string", "minLength": 1 }
        }
      },
      "CurrentUser": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractVersion", "userId", "username", "roles"],
        "properties": {
          "contractVersion": { "const": "v1" },
          "userId": { "type": "string", "format": "uuid" },
          "username": { "type": "string" },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["VIEWER", "ANALYST", "OPERATOR", "ADMIN"] }
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["title", "status", "detail"],
        "properties": {
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/platform/status": {
      "get": {
        "operationId": "getPlatformStatus",
        "responses": {
          "200": {
            "description": "Core and AI service contract status",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/platform-contract-v1.json#/$defs/PlatformStatus" }
              }
            }
          },
          "503": { "description": "AI service contract unavailable" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Short-lived access token",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } }
            }
          },
          "400": { "description": "Invalid request" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refreshAccessToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Rotated access and refresh token pair",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } }
            }
          },
          "401": { "description": "Invalid, expired, revoked, or reused refresh token" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" } }
          }
        },
        "responses": {
          "204": { "description": "Token family revoked and current access token blacklisted" },
          "401": { "description": "Invalid access or refresh token" }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user claims",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CurrentUser" } }
            }
          },
          "401": { "description": "Missing, invalid, or expired access token" }
        }
      }
    },
    "/api/v1/sources": {
      "post": { "operationId": "createSource", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/CreateSource" } } } },
        "responses": { "201": { "description": "Source registered", "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/Source" } } } }, "400": { "description": "Invalid source" }, "409": { "description": "Duplicate source key" } } }
    },
    "/api/v1/sources/{id}": {
      "get": { "operationId": "getSource", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Source", "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/Source" } } } }, "404": { "description": "Source not found" } } }
    },
    "/api/v1/evidence": {
      "post": { "operationId": "createEvidence", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/CreateEvidence" } } } },
        "responses": { "201": { "description": "Evidence registered", "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/Evidence" } } } }, "400": { "description": "Invalid evidence" }, "404": { "description": "Source not found" } } }
    },
    "/api/v1/evidence/{id}": {
      "get": { "operationId": "getEvidence", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Evidence", "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/Evidence" } } } }, "404": { "description": "Evidence not found" } } }
    },
    "/api/v1/assumptions": {
      "post": { "operationId": "createAssumption", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/CreateAssumption" } } } },
        "responses": { "201": { "description": "Assumption registered", "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/Assumption" } } } }, "400": { "description": "Invalid assumption" }, "409": { "description": "Duplicate assumption key" } } }
    },
    "/api/v1/assumptions/{id}": {
      "get": { "operationId": "getAssumption", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Assumption", "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/Assumption" } } } }, "404": { "description": "Assumption not found" } } }
    },
    "/api/v1/provenance-links": {
      "post": { "operationId": "createProvenanceLink", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/CreateProvenanceLink" } } } },
        "responses": { "201": { "description": "Provenance link registered", "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/ProvenanceLink" } } } }, "400": { "description": "Exactly one origin is required" }, "404": { "description": "Origin not found" }, "409": { "description": "Duplicate link" } } },
      "get": { "operationId": "getProvenanceLinks", "security": [{ "bearerAuth": [] }], "parameters": [
          { "name": "subjectType", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1 } },
          { "name": "subjectId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Ordered provenance links", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/ProvenanceLink" } } } } } } }
    },
    "/api/v1/provenance-links/{id}": {
      "get": { "operationId": "getProvenanceLink", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Provenance link", "content": { "application/json": { "schema": { "$ref": "../schemas/provenance-contract-v1.json#/$defs/ProvenanceLink" } } } }, "404": { "description": "Provenance link not found" } } }
    },
    "/api/v1/admin/ingestions": {
      "get": { "operationId": "listRecentIngestionRuns", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Recent ingestion runs", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "../schemas/ingestion-contract-v1.json#/$defs/IngestionResult" } } } } }, "403": { "description": "Admin role required" } } }
    },
    "/api/v1/admin/ingestions/{source}": {
      "post": { "operationId": "startExternalDataIngestion", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "source", "in": "path", "required": true, "schema": { "$ref": "../schemas/ingestion-contract-v1.json#/$defs/SourceSystem" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/ingestion-contract-v1.json#/$defs/StartIngestion" } } } }, "responses": { "201": { "description": "Ingestion completed", "content": { "application/json": { "schema": { "$ref": "../schemas/ingestion-contract-v1.json#/$defs/IngestionResult" } } } }, "400": { "description": "Invalid parameters or source failure" }, "403": { "description": "Admin role required" } } }
    },
    "/api/v1/admin/ingestions/{id}": {
      "get": { "operationId": "getIngestionRun", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Ingestion result", "content": { "application/json": { "schema": { "$ref": "../schemas/ingestion-contract-v1.json#/$defs/IngestionResult" } } } }, "403": { "description": "Admin role required" }, "404": { "description": "Run not found" } } }
    },
    "/api/v1/ontology": {
      "get": { "operationId": "getEconomicCivilizationOntology", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Versioned ontology", "content": { "application/json": { "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/Ontology" } } } } } }
    },
    "/api/v1/ontology/actions/validate": {
      "post": {
        "operationId": "validateOntologyAction",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/ValidateAction" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action type and parameters validation result; no action is executed",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/ActionValidation" }
              }
            }
          },
          "400": { "description": "Malformed validation request" },
          "404": { "description": "Action type not found" }
        }
      }
    },
    "/api/v1/world-versions/{versionId}/graph/entities": {
      "post": { "operationId": "createWorldGraphEntity", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "versionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/CreateGraphEntity" } } } }, "responses": { "201": { "description": "Graph entity created", "content": { "application/json": { "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/GraphEntity" } } } }, "400": { "description": "Invalid entity" }, "404": { "description": "World version or type not found" }, "409": { "description": "Duplicate natural key" } } }
    },
    "/api/v1/world-versions/{versionId}/graph/relationships": {
      "post": { "operationId": "createWorldGraphRelationship", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "versionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/CreateGraphRelationship" } } } }, "responses": { "201": { "description": "Graph relationship created", "content": { "application/json": { "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/GraphRelationship" } } } }, "400": { "description": "Invalid relationship" }, "404": { "description": "World version or endpoint not found" }, "409": { "description": "Conflicting relationship" } } }
    },
    "/api/v1/world-versions/{versionId}/graph": {
      "get": { "operationId": "getWorldGraph", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "versionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Aggregate-safe economic civilization graph", "content": { "application/json": { "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/WorldGraph" } } } }, "404": { "description": "World version not found" } } }
    },
    "/api/v1/world-versions/{versionId}/graph/entities/resolve": {
      "post": { "operationId": "resolveWorldGraphEntity", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "versionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/ResolveGraphEntity" } } } },
        "responses": { "200": { "description": "Entity conservatively resolved by exact identifier", "content": { "application/json": { "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/EntityResolution" } } } }, "400": { "description": "Untrusted or malformed identifier" }, "409": { "description": "Identifiers disagree; merge refused" } }
      }
    },
    "/api/v1/world-versions/{versionId}/graph/projections": {
      "post": { "operationId": "projectWorldGraphToNeo4j", "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "versionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "PostgreSQL source-of-truth snapshot projected atomically", "content": { "application/json": { "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/GraphProjection" } } } }, "502": { "description": "Projection failed and was audited" } }
      }
    },
    "/api/v1/world-versions/{versionId}/graph/paths/{rootEntityId}": {
      "get": { "operationId": "getWorldGraphPaths", "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "versionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "rootEntityId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "maxDepth", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 3, "default": 3 } }
        ],
        "responses": { "200": { "description": "Bounded one-to-three-hop industrial and society paths", "content": { "application/json": { "schema": { "$ref": "../schemas/ontology-contract-v1.json#/$defs/GraphPaths" } } } }, "404": { "description": "Root entity not found" }, "503": { "description": "Neo4j is disabled or unavailable" } }
      }
    }
  }
}
