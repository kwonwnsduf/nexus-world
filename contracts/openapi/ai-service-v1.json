{
  "openapi": "3.1.0",
  "info": { "title": "NEXUS WORLD AI Service", "version": "1.1.0" },
  "paths": {
    "/api/v1/simulations/execute": {
      "post": {
        "operationId": "executeDeterministicIndustrialSimulation",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "oneOf": [{ "$ref": "../schemas/simulation-contract-v1.json#/$defs/SimulationRequest" }, { "$ref": "../schemas/simulation-contract-v1.json#/$defs/GraphSimulationRequest" }] } } } },
        "responses": {
          "200": {
            "description": "Deterministic turn snapshots and final state",
            "content": { "application/json": { "schema": { "oneOf": [
              { "$ref": "../schemas/simulation-contract-v1.json#/$defs/SimulationResult" },
              { "$ref": "../schemas/simulation-contract-v1.json#/$defs/GraphSimulationResult" }
            ] } } }
          },
          "422": { "description": "Invalid state graph or bounded input" }
        }
      }
    },
    "/api/v1/scenarios/interpret": {
      "post": {
        "operationId": "extractStructuredScenarioCandidate",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/scenario-workflow-contract-v1.json#/$defs/ScenarioQuery" } } } },
        "responses": {
          "200": { "description": "Natural language extracted without entity resolution or numerical propagation", "content": { "application/json": { "schema": { "$ref": "../schemas/scenario-workflow-contract-v1.json#/$defs/ScenarioCandidate" } } } },
          "422": { "description": "OpenAI structured extraction unavailable or invalid" }
        }
      }
    },
    "/api/v1/retrieval/documents": {
      "post": {
        "operationId": "ingestRetrievalDocument",
        "responses": { "201": { "description": "Section-aware chunks created" } }
      }
    },
    "/api/v1/retrieval/search": {
      "post": {
        "operationId": "searchEvidence",
        "responses": { "200": { "description": "Ranked keyword, vector, or hybrid evidence" } }
      }
    },
    "/api/v1/retrieval/answer": {
      "post": {
        "operationId": "answerFromEvidence",
        "responses": { "200": { "description": "Extractive answer with resolvable citations" } }
      }
    },
    "/api/v1/graphrag/query": {
      "post": {
        "operationId": "queryEvidenceGroundedGraph",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/graphrag-contract-v1.json#/$defs/GraphRagQuery" } } } },
        "responses": {
          "200": { "description": "Ranked bounded industrial and society paths with graph and text evidence", "content": { "application/json": { "schema": { "$ref": "../schemas/graphrag-contract-v1.json#/$defs/GraphRagResult" } } } },
          "503": { "description": "Graph projection is disabled or unavailable" }
        }
      }
    },
    "/api/v1/platform/capabilities": {
      "get": {
        "operationId": "getAiCapabilities",
        "responses": {
          "200": {
            "description": "AI service capabilities",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/platform-contract-v1.json#/$defs/AiCapabilities" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  }
}
